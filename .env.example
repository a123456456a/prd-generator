# Copy to repo root `.env` (preferred) or `apps/api/.env`
PORT=3000
API_KEY=dev-api-key
# OpenAI-compatible provider. For DeepSeek:
#   OPENAI_API_KEY=<your DeepSeek key>
#   OPENAI_BASE_URL=https://api.deepseek.com
#   EXTRACT_MODEL=deepseek-v4-flash
#   PRD_MODEL=deepseek-v4-flash
# Note: Whisper voice transcription is OpenAI-only; DeepSeek has no audio API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional: jsonMode | functionCalling | jsonSchema (DeepSeek auto-uses jsonMode)
STRUCTURED_OUTPUT_METHOD=
EXTRACT_MODEL=gpt-4o-mini
PRD_MODEL=gpt-4o
UPLOAD_DIR=uploads
PUBLIC_DIR=public
WEB_DIST_DIR=public/web
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prd-generator
ADMIN_USER=admin
ADMIN_PASSWORD=admin-change-me
SESSION_TTL_MS=604800000
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=
TASK_TTL_MS=604800000
MAX_CONCURRENT_TASKS=10
DAILY_TOKEN_BUDGET=500000
