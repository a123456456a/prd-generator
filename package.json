{
  "name": "prd-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm run --parallel /^dev:/",
    "dev:api": "pnpm --filter @prd/api dev",
    "dev:web": "pnpm --filter @prd/web dev",
    "build": "pnpm --filter @prd/web build && pnpm --filter @prd/api build",
    "build:api": "pnpm --filter @prd/api build",
    "build:web": "pnpm --filter @prd/web build",
    "start": "pnpm --filter @prd/api start",
    "test": "pnpm --filter @prd/api test",
    "test:api": "pnpm --filter @prd/api test",
    "test:web": "pnpm --filter @prd/web test"
  }
}
