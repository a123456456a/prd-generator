# Prefer repo-root `.env`. This file is optional override for @prd/api.
PORT=3000
API_KEY=dev-api-key
OPENAI_API_KEY=
EXTRACT_MODEL=gpt-4o-mini
PRD_MODEL=gpt-4o
UPLOAD_DIR=uploads
PUBLIC_DIR=public
WEB_DIST_DIR=public/web
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prd-generator
ADMIN_USER=admin
ADMIN_PASSWORD=admin-change-me
SESSION_TTL_MS=604800000
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
